PORT=8080
# Comma-separated browser origins allowed to open a WebSocket.
# Default is the GitHub Pages origin. Local `bun run dev` also allows private LAN hosts.
WEAVO_ALLOWED_ORIGINS=https://soham0w0sarkar.github.io
# SQLite file of each room's document. A joiner loads this before catching up from peers.
# Unset uses weavo.sqlite. Set to off to keep the relay memory-only.
WEAVO_DB=weavo.sqlite
