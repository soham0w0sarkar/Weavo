{
  "name": "@weavo/textarea-adapter",
  "version": "1.0.0",
  "description": "Bind a native textarea to a Weavo document — IME, selection, and remote apply.",
  "keywords": [
    "weavo",
    "textarea",
    "adapter",
    "collaborative-editing",
    "crdt",
    "ime"
  ],
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/soham0w0sarkar/Weavo.git",
    "directory": "packages/textarea-adapter"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "tsup src/index.ts --format cjs,esm --dts --watch",
    "build": "tsup src/index.ts --format cjs,esm --dts",
    "test": "bun test --preload ./test/setup.ts"
  },
  "dependencies": {
    "@weavo/client": "^3.0.0"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "^20.10.6",
    "@repo/typescript-config": "workspace:*",
    "bun-types": "^1.3.9",
    "happy-dom": "^20.10.6",
    "tsup": "^8.5.1",
    "typescript": "5.9.2"
  }
}
