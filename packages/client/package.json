{
  "name": "@weavo/client",
  "version": "3.0.0",
  "description": "Real-time collaborative text editing for the browser — connect a Weavo document to a WebSocket room; pair with an editor adapter to bind a textarea, Monaco, or others.",
  "keywords": [
    "weavo",
    "collaborative-editing",
    "crdt",
    "real-time",
    "text-editing",
    "websocket",
    "browser",
    "sync"
  ],
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/soham0w0sarkar/Weavo.git",
    "directory": "packages/client"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "tsup src/index.ts --format cjs,esm --dts --watch",
    "build": "tsup src/index.ts --format cjs,esm --dts",
    "test": "bun test --preload ./test/setup.ts",
    "test:load": "bun test --preload ./test/setup.ts ./test/responseSuppression.load.test.ts"
  },
  "dependencies": {
    "@weavo/core": "^2.0.1",
    "@weavo/membership": "^1.0.1",
    "@weavo/sync": "^2.0.1",
    "@weavo/transport": "^2.0.2"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "^20.10.6",
    "@repo/typescript-config": "workspace:*",
    "bun-types": "^1.3.9",
    "fast-check": "^4.6.0",
    "happy-dom": "^20.10.6",
    "tsup": "^8.5.1",
    "typescript": "5.9.2"
  }
}
